	DCA TIME1	/GET TIME IN DEVICE FORMAT
	TAD TIME2
	RTL
	RTL
	AND [7		/GET LOW ORDER
	TAD TIME1
	DCA TIME1	/TIME NOW (IN 12 BIT FORM)
	TAD SNOOP+1	/TIME THEN
	STL CIA		/-TIME THEN
	TAD TIME1	/+TIME NOW
	SZL		/HAVE WE GONE THROUGH MIDNIGHT?
	TAD	TIMC1	/YES; FUDGE RESULT
TIM2,	DCA WS0		/SAVE TIME ASSIGNED
	TAD WS0		/NOW CONVERT BACK TO 24 BIT FORM
	RTR
	RAR
	AND [777	/HI ORDER
	DCA TIME1
	TAD WS0
	AND [7
	CLL RTR
	RTR
	DCA TIME2	/LOW ORDER
