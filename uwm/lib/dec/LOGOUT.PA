/ROUTINE TO DO THE TIME EVALUATIONS

TIMM,	STA		/GET USER RUN TIME
	TAD TIMA
	URT
	TAD (MESS9
	PUTCHR
	P 10		/"RUNTIME"
	PUTIME		/NOW THE TIME
	TAD (MESS10
	PUTCHR
	P 2		/" ("
	STA		/GET IT AGAIN, SINCE PUTIME EATS IT UP
	TAD TIMA
	URT
	TAD TIME2	/COMPUTE ACCOUNTING INFO.
	CLL RTR
	RTR
	RTR
	AND [77
	DCA WS0
	TAD TIME1
	AND [77
	CLL RTL
	RTL
	RTL
	TAD WS0
	PUTNUM		/TYPE # CPU UNITS
	S D 3
