/ROUTINE TO MOVE AN ASCII STRING
/INTO THE OUTPUT BUFFER. ONE ARGUMENT
/BIT0 IS SET IF CHARS ARE PACKED
/BIT1 IS SET IF THEY ARE PACKED
/     IN TSS/8 INTERNAL CODE
/BITS 6-11 CONTAIN CHARACTER COUNT
/ENTER WITH PTR. TO STRING IN ACC.
P=4000
T=2000

OUTCHR,	0
	DCA	CHRPTR
	TAD I	OUTCHR
	AND	(77)
	CIA
	DCA	OUTCNT
/ARE THE CHARS PACKED?
	TAD I	OUTCHR
	SPA CLA
	JMP	UNPACK		/YES

/COMES HERE IF CHARS ARE ALREADY IN
/8-BIT ASCII.
	TAD I	CHRPTR
	DCA I	POINT
	ISZ	CHRPTR
	ISZ	POINT
	ISZ	OUTCNT
	JMP	.-5
OTCEXT,	CLA
	ISZ	OUTCHR
	JMP I	OUTCHR
CHRPTR,	0
OUTCNT,	0

/COMES HERE IF CHARS ARE PACKED
/ARE THEY IN INTERNAL CODE?

UNPACK,	TAD I	OUTCHR
	RTL;	CLA
	SZL
	TAD	(40)
	DCA	CONVRT
/NOW START GETTING CHARS
NPCK1,	TAD I	CHRPTR
	RTR;	RTR;	RTR
	JMS	EXPAND
	ISZ	OUTCNT
	SKP
	JMP	OTCEXT
	TAD I	CHRPTR
	JMS	EXPAND
	ISZ	CHRPTR
	ISZ	OUTCNT
	JMP	NPCK1
	JMP	OTCEXT
CONVRT,	0

/EXPAND THE 6-BIT AC CHAR TO 8-BITS,
/THEN PUT IT IN OUTPUT BUFFER

EXPAND,	0
	TAD	CONVRT
	AND	(77)
	DCA	SIXBIT
	TAD	SIXBIT
	AND	(40)
	SNA CLA
	TAD	(100)
	TAD	(200)
	TAD	SIXBIT
	DCA I	POINT
	ISZ	POINT
	JMP I	EXPAND
SIXBIT,	0

/ROUTINE TO PUT SOME BLANKS IN THE
/OUTPUT BUFFER

BLANK0,	0
	TAD I	BLANK0
	CIA
	DCA	BLNKCT
	TAD	(SPACE)
	PUTCHR
	0001			/ONE 8-BIT SPACE
	ISZ	BLNKCT
	JMP	.-4
	JMP I	BLANK0
BLNKCT,	0
SPACE,	240
