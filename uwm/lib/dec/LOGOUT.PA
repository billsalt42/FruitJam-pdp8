/ROUTINE TO GET OPTION FROM USER

/CALL	GETOPT
/	POINTER TO RESPONSE LIST
/	RETURN WITH RELATIVE POSITON IN LIST OF RESPONSE

/	THE NULL RESPONSE (CR) IS RESPONSE 0
/	AN INVALID RESPONSE RESULTS IN A CALL TO DIRECT, TO PRINT
/	INSTRUCTIONS

GETOP0,	0
	TAD [KEYBUF	/INITIALIZE INPUT BUFFER
	DCA KEY
GETOP1,	KRB		/GET CHARACTER
	DCA I KEY	/SAVE IT
	TAD I KEY	/WHAT IS IT
	TAD [-215	/CR?
	SNA
	JMP GETCR	/YES
	TAD [-212+215	/LINE-FEED
	SNA
	JMP GETCR	/YES
	TAD [-377+212	/RUBOUT?
	SNA
	JMP GETRO	/YES
	TAD [-240+377	/SPACE
	SNA CLA
	JMP GETOP1	/YES; IGNORE IT
	ISZ KEY		/READY FOR NEXT CHARACTER
	JMP GETOP1

GETRO,	TAD KEY		/ANYTHING TO RUB OUT?
	TAD [-KEYBUF
	SPA SNA CLA
	JMP .+4		/NO- ECHO \ BUT DON'T MOVE POINTER
	STA
	TAD KEY
	DCA KEY		/MOVE POINTER BACK ONE CHARACTER
	TAD ["\		/NOW ECHO RUBOUT
	TLS
	JMP GETOP1	/AND CONTINUE

GETCR,	CRLF		/ECHO CR-LF
	TAD I GETOP0	/GET POINTER TO LIST
	DCA 17
	DCA 16		/LIST POSITION COUNTER
	ISZ GETOP0	/FOR EXIT
	TAD KEY		/NULL INPUT?
	TAD [-KEYBUF
	SNA CLA
	JMP I GETOP0	/YES- RETURN 0
GETOP2,	TAD I 17	/GET LIST ELEMENT
	SNA
	JMP DIRECT	/NOT A VALID RESPONSE
	TAD I [KEYBUF	/MATCH?
	SNA CLA
	JMP .+3		/YES
	ISZ 16
	JMP GETOP2	/NO- KEEP LOOKING
	TAD 16		/RETURN LIST INDEX+1
	IAC
	JMP I GETOP0	/AND AWAY



DIRECT,	TAD [D1		/INITIALIZE LIST
	DCA WS1
DIR2,	TAD I WS1	/GET COUNT FOR THIS LINE
	ISZ WS1
	DCA DIR1
	TAD I WS1	/GET ADDRESS OF STRING
	ISZ WS1
	SNA
	JMP DIR3	/DONE- REQUEST CONFIRMATION
	PUTCHR
DIR1,	0		/COUNT + P
	OUTPUT		/TYPE THE LINE
	CRLF
	JMP DIR2	/KEEP GOING

DIR3,	CRLF
	TAD [CONFRM	/"CONFIRM: "
	PUTCHR
	P 11
	OUTPUT
	TAD [UFD	/REINITIALIZE UFD BUFFER
	DCA FIPTR
	DCA DELC	/CLEAR COUNTS
	DCA DELB
	DCA SAVC
	DCA SAVB
	AGAIN		/NOW TRY IT ALL OVER
/ROUTINE TO SEE IF CURRENT FILE IS A TEMP OR BASIC TEMP FILE
/IF SO; IT IS DELETED, AND RETURN IS TO DELF2
/IF NOT; RETURN IS MADE NORMALLY

TMPDEL,	0
	TAD FIPTR
	DCA TMPTR	/GET OUT OWN COPY OF FIPTR
	TAD I TMPTR	/GET FIRST WORD OF FILE NAME
	TAD TMBA
	SZA CLA		/IS IT "BA"
	JMP TMPD2	/NO- TRY "TEMP"
	ISZ TMPTR	/YES
	TAD I TMPTR
	TAD TMS1	/SECOND WORD "S1"?
	SNA
	JMP .+4		/YES- CHECK LAST WORD
	IAC		/NO- IS IT "S0"
TMPD3,	SZA CLA
	JMP TMPD4	/NO; CHECK EXTENSION BITS
	ISZ TMPTR	/DOES LAST WORD MATCH CONSOLE #?
	TAD I TMPTR
	CIA
	TAD TTYASC	/ASCII VERSION OF TTY #
	SZA CLA
	JMP TMPD4	/NO; CHECK EXTENSION BITS

TEMPD1,	TAD [-4		/DELTER FILE- ARE WE IN INDIVIDUAL MODE?
	TAD OPT
	SZA CLA
	JMP .+6		/NO- JUST DELETE IT
	TAD [MESS4	/YES- TYPE "DELETED"
	PUTCHR
	P 7
	OUTPUT
	CRLF
	KILL

TMPD2,	TAD I TMPTR	/NOT BASIC FILE- IS IT "TEMP"?
	TAD TMTE
	SZA CLA
	JMP TMPD4	/NO; CHECK EXTENSION BITS
	ISZ TMPTR
	TAD TMMP
	TAD I TMPTR
	JMP TMPD3	/CHECK  "MP"

TMPD4,	TAD FIPTR	/IS FILE EXTENSION 1600 (=TMP)
	TAD [4
	DCA TMPTR	/POINTS TO  EXTENSION BITS IN NAME BLOCK
	TAD I TMPTR
	AND [7600	/EXTRACT EXTENSION
	TAD [-1600
	SZA CLA
	JMP I TMPDEL	/NOT TMP
	JMP TEMPD1	/IS TEMP
TMBA,	-4241
TMS1,	-6321
TMTE,	-6445
TMMP,	-5560
	PAGE
/ROUTINE TO OUTPUT THE DATE
/FILLS A 11 (DECIMAL) WORD ZONE
/"XX AAA YY"
/XX IS DAY OF THE MONTH
/AAA IS MONTH
/YY IS YEAR
/ENTER WITH DATE WORD IN ACC
DATER,	0
	DCA	DATDAY		/SAVE DATE WORD
	DCA	DATYR
DATE1,	TAD 	DATDAY
	SMA CLA			/NEGATIVE DATE?
	JMP	DATE2		/NO; OK
	ISZ DATYR		/YES; FUDGE YEAR AND MAKE DATE POSITIVE
	TAD DATDAY
	TAD (-564)		/564 (OCTAL) DAYS= 1 (OCTAL) YEAR
	DCA DATDAY
	JMP DATE1

DATE2,	DCA	DATMON
/NOW CALCULATE THE DAY OF THE MONTH
	TAD	DATDAY
	TAD	(-37)		/-31 DECIMAL
	SPA
	JMP	.+4
	ISZ	DATMON
	DCA	DATDAY
	JMP	.-6
	CLA
	ISZ	DATDAY

/NOW HAVE THE DAY OF THE MONTH IN
/DATDAY.
/YEAR *12 + MONTH IN DATMON
	TAD	(112)		/74 DECIMAL
	TAD DATYR
	DCA	DATYR
/YEAR IS CALCULATED AS BEING FROM 1974.
	TAD	DATMON
	TAD	(-14)		/12 DECIMAL
	SPA
	JMP	.+4
	ISZ	DATYR
	DCA	DATMON
	JMP	.-6
	CLA
/NOW HAVE THE YEAR IN DATYR
/MONTH IS IN DATMON
/DAY IN ATDAY

/NOW PUT DAY OF MONTH IN BUFFER
	TAD	DATDAY
	PUTNUM
	S D 2			/TWO DEC. DIGITS


/NOW GET CHAR STRING FOR MONTH
	BLANK
	01			/SKIP A SPACE
	TAD	DATMON
	CLL	RAL
	TAD	DATMON		/MONTH *3
	TAD	(MONTHS)
	PUTCHR
	03			/MONTH IS 3 8-BIT CHARS

/NOW PUT IN THE YEAR
	BLANK
	01
	TAD	DATYR
	PUTNUM
	D 2			/TWO DECIMAL DIGITS
	JMP I	DATER

