/ROUTINE TO SAVE A FILE
FILS,	JMS TMPDEL	/IS IT A TEMPORARY FILE?
	JMS SAVCNT	/NO- SAVE IT
	JMP DELF2	/NEXT FILE

SAVCNT,	0		/ROUTINE TO UPDATE SAVED FILE STATISTICS
	ISZ SAVC	/FILE COUNT +1
	TAD FIPTR
	TAD [5
	DCA WS0		/POINTS TO SEGMENT SIZE
	TAD I WS0
	TAD SAVB
	DCA SAVB	/ACCUMULATE INTO TOTAL
	JMP I SAVCNT


/ROUTINE TO DELETE A FILE
FILK,	JMS FIOPN	/OPEN THE FILE ON LOGICAL FILE 1
	JMP FILS+1	/COULDN'T OPEN IT- MIGHT AS WELL SAVE IT
	TAD (FILRED	/NOW REDUCE IT
	RED
	SZA CLA		/WERE WE SUCCESSFULL?
	JMP FILS+1
	ISZ DELC	/YES- FILE COUNT+1
	TAD FIPTR
	TAD [5
	DCA WS0		/POINTS TO # SEGMENTS
	TAD I WS0
	TAD DELB
	DCA DELB	/ACCUMULATE INTO TOTAL
	JMP DELF2
