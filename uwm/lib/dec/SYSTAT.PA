	PAGE
/ROUTINE TO OUTPUT THE DATE
/FILLS A 11 (DECIMAL) WORD ZONE
/"XX AAA YY"
/XX IS DAY OF THE MONTH
/AAA IS MONTH
/YY IS YEAR
/ENTER WITH DATE WORD IN ACC
DATER,	0
	DCA	DATDAY		/SAVE DATE WORD
	DCA	DATYR
DATE1,	TAD 	DATDAY
	SMA CLA			/NEGATIVE DATE?
	JMP	DATE2		/NO; OK
	ISZ DATYR		/YES; FUDGE YEAR AND MAKE DATE POSITIVE
	TAD DATDAY
	TAD (-564)		/564 (OCTAL) DAYS= 1 (OCTAL) YEAR
	DCA DATDAY
	JMP DATE1
DATE2,	DCA	DATMON
/NOW CALCULATE THE DAY OF THE MONTH
	TAD	DATDAY
	TAD	(-37)		/-31 DECIMAL
	SPA
	JMP	.+4
	ISZ	DATMON
	DCA	DATDAY
	JMP	.-6
	CLA
	ISZ	DATDAY
/NOW HAVE THE DAY OF THE MONTH IN
/DATDAY.
/YEAR *12 + MONTH IN DATMON
	TAD	(112)		/74 DECIMAL
	TAD DATYR
	DCA	DATYR
/YEAR IS CALCULATED AS BEING FROM 1974.
	TAD	DATMON
	TAD	(-14)		/12 DECIMAL
	SPA
	JMP	.+4
	ISZ	DATYR
	DCA	DATMON
	JMP	.-6
	CLA
/NOW HAVE THE YEAR IN DATYR
/MONTH IS IN DATMON
/DAY IN ATDAY
/NOW PUT DAY OF MONTH IN BUFFER
	TAD	DATDAY
	PUTNUM
	S D 2			/TWO DEC. DIGITS
/NOW GET CHAR STRING FOR MONTH
	BLANK
	01			/SKIP A SPACE
	TAD	DATMON
	CLL	RAL
	TAD	DATMON		/MONTH *3
	TAD	(MONTHS)
	PUTCHR
	03			/MONTH IS 3 8-BIT CHARS
/NOW PUT IN THE YEAR
	BLANK
	01
	TAD	DATYR
	PUTNUM
	D 2			/TWO DECIMAL DIGITS
	JMP I	DATER
DATDAY,	0
DATMON,	0
DATYR,	0
