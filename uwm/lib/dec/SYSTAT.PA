/ROUTINE TO TAKE A VALUE AND PUT IT IN
/THE OUTPUT BUFFER.
/BIT0 OF ARGUMENT IS SET TO INDICATE
/	THAT LEADING ZEROES ARE TO BE
/	SUPPRESSED
/BIT1 IS SET TO INDICATE A DECIMAL
/BITS9-11 INDICATE # OF PLACES TO FILL
S=4000
D=2000
NUMBER,	0
	DCA	NUM0		/SAVE VALUE
/ARE WE SUPPRESSING LEADING ZEROES?
	TAD I	NUMBER
	RAL
	CLA
	TAD	(240)
	SNL
	TAD	(20)
	DCA	P1000
/IF WE ARE SUPPRESSING, FILL THE DIGITS
/REGISTERS WITH BLANKS. OTHERWISE, FILL
/WITH ZEROES.
	TAD	P1000
	DCA	P100
	TAD	P100
	DCA	P10
	TAD	P10
	DCA	P1
	TAD	(P1)
	DCA	NUMPTR

/IS THE NUMBER TO BE OUTPUT IN OCTAL?
	TAD I	NUMBER
	RAL
	SPA CLA
	JMP	NUMDEC		/NO

/COMES HERE TO OUTPUT A NUMBER IN
/OCTAL
NUMOCT,	TAD	NUM0
	AND	(7)
	TAD	(260)		/FORM AN ASCII DIGIT
	DCA I	NUMPTR
	STA
	TAD	NUMPTR
	DCA	NUMPTR
	TAD	NUM0
	AND	(7770)
	SNA			/DONE?
	JMP	NUMOUT		/YES
	CLL RTR
	RAR
	DCA	NUM0
	JMP	NUMOCT

/COMES HERE WHEN THE PROPER ASCII
/CHARS HAVE BEEN ASSEMBLED IN
/P1000, P100, P10, P1

NUMOUT,	TAD I	NUMBER
	AND	(7)
	DCA	NUMARG		/# OF CHARS TO PUT OUT
	TAD	NUMARG
	CIA
	IAC
	TAD	(P1)
	PUTCHR
NUMARG,	0
	ISZ	NUMBER
	JMP I	NUMBER

/COMES HERE IF THE NUMBER IS TO BE OUT-
/PUT IN DECIMAL.
/FIRST STEP IS TO BREAK IT INTO BCD DECIMAL

NUMDEC,	DCA	THOU
	DCA	HUN
	DCA	TEN
	DCA	ONE
/NUMBER TO BE CONVERTED TO DECIMAL MUST
/BE <2047 (>2047 IS TREATED AS NEGATIVE)
/IF NUM0 IS >2047, AND OFF BIT0 (THERE-
/BY SUBTRACTING 2048 DECIMAL) ADD 48
/DECIMAL AND RESTORE TO NUM0.  THIS
/EFFECTIVELY REDUCES NUM0 BY 2000
/DECIMAL.  ISZ THOU TWICE TO OFFSET

DECTST,	TAD	NUM0
	SMA
	JMP	ND1000-1
	AND	[3777]
	TAD	[60]		/48 DECIMAL
	DCA	NUM0
	ISZ	THOU
	ISZ	THOU
	JMP	DECTST
	CLA
ND1000,	TAD	NUM0
	TAD	(-1750)		/-1000 DECIMAL
	SPA
	JMP	ND100-1
	DCA	NUM0
	ISZ	THOU
	JMP	ND1000
	CLA
ND100,	TAD	NUM0
	TAD	(-144)		/-100 DECIMAL
	SPA
	JMP	ND10-1
	DCA	NUM0
	ISZ	HUN
	JMP	ND100

	CLA
ND10,	TAD	NUM0
	TAD	(-12)		/-10 DECIMAL
	SPA
	JMP	ND1-1
	DCA	NUM0
	ISZ	TEN
	JMP	ND10
	CLA
ND1,	TAD	NUM0
	DCA	ONE

/NOW MOVE THE DIGITS INTO P1000...P1
	TAD	THOU
	SZA
	JMP	NMD1
	TAD	HUN
	SZA
	JMP	NMD2
	TAD	TEN
	SZA
	JMP	NMD3
	JMP	NMD4
NMD1,	TAD	(260)
	DCA	P1000
	TAD	HUN
NMD2,	TAD	(260)
	DCA	P100
	TAD	TEN
NMD3,	TAD	(260)
	DCA	P10
NMD4,	TAD	ONE
	TAD	(260)
	DCA	P1
	JMP	NUMOUT

THOU,	0
HUN,	0
TEN,	0
ONE,	0
P1000,	0
P100,	0
P10,	0
P1,	0
NUM0,	0
NUMPTR,	0
	PAGE
/ROUTINE TO TYPE OUT THE CONTENTS OF
/THE OUTPUT CHARACTER BUFFER
/RESETS "POINT" AFTER TYPING

TYPE,	0
	TAD	(CRLF)
	PUTCHR			/CLOSE LINE WITH CRLF
	0002
/NOW SET UP PARAMETER BLOCK FOR AN SAS
	STA
	TAD	(CHRBUF)
	DCA	SASPNT
	TAD	POINT
	CIA
	TAD	(CHRBUF)
	DCA	SASWC
/NOW OUTPUT VIA AN SAS
	TAD	(SASWC)
PATCH4,	SAS		/PATCHED TO 6660 FOR LPT
	JMP	.-2
	TAD	(CHRBUF)
	DCA	POINT
	JMP I	TYPE

CRLF,	215
	212
SASWC,	0
SAS=6040
SASPNT,	0
/ROUTINE TO CONVERT VALUE IN NUMHO AND NUMHO+1 (IN TICKS)
/TO HOURS, MINUTES AND SECONDS.
/THE RESULT IS STORED IN OUTPUT BUFFER AS HH:MM:SS

TIME,	0			/ENTER WITH AC=0
	TAD NUMHO
	TAD PTAB
	IAC
	SMA CLA
	JMP HR100
	ISZ PTABX
	ISZ PTABX1
	TAD PTFORM
	
HR100,	TAD PTFORM
	DCA PTCONT
	TAD	PTABX		/SET UP TABLE FETCH(LOW)
	DCA	PTIMX	
	TAD	PTABX1		/SET UP TABLE FETCH(HIGH)
	DCA	PTIMX1

PTLOOP,	TAD	PT0260		/INITIALIZE DIGIT COUNTER
	DCA	PTDIGI
	CLL			/INITIALIZE DIGIT COUNTER
	TAD	NUMHO+1		/DOUBLE PRECISION ADD
PTIMX,	NOP			/(TAD PTAB1+N)
	DCA	NUMHO+2		/SAVE LOW ORDER REMAINDER
	RAL			/GET OVERFLOW
	TAD	NUMHO		/ADD HIGH ORDER
PTIMX1,	NOP			/(TAD PTAB+N)
	SNL
	JMP	PTIMA		/DIVIDE OVERFLOW
	DCA	NUMHO		/RESTORE REMAINDER
	TAD	NUMHO+2		/LOW ORDER RESTORE
	DCA	NUMHO+1
	ISZ	PTDIGI		/COUNT THIS SUBTRACTION
	JMP	PTIMX-2		/CONTINUE LOOP

PTIMA,	ISZ	PTIMX		/ADVANCE TABLE FETCH
	ISZ	PTIMX1		/ADVANCE TABLE FETCH
	CLA			/CLEAR OUT REMAINDER
	TAD PTDIGI
	DCA I	POINT		/PUT CHAR IN OUTPUT BUFFER
	ISZ	POINT
	TAD	PTCONT
	SNA			/TEST FOR ALL DONE
	JMP GOFOR
	RAL CLL			/TEST FOR COLON PRINT
	DCA	PTCONT		/RESTORE FORMAT
	SZL			/PRINT COLON?
	JMP	PTLOOP		/CONTINUE LOOP
	TAD PTCOLN
	DCA I	POINT
	ISZ	POINT
	JMP	PTLOOP		/CONTINUE LOOP
GOFOR,	TAD X1
	DCA PTABX
	TAD Y1
	DCA PTABX1
	JMP I TIME
X1,	TAD PTAB1
Y1,	TAD PTAB
PTABX,	TAD	PTAB1		/TABLE FETCH LOW
PTABX1,	TAD	PTAB			/TABLE FETCH HIGH
PTFORM,	6500			/FORAMT FOR OUTPUT
PT0260,	260
PTCOLN,	272
PTDIGI,	0
PTCONT,	0

PTAB,	6621;7650;7767;7776;-1;-1;-1

PTAB1,	0600;0700;1540;4220;6650;7634;7766
	PAGE
/ROUTINE TO MOVE AN ASCII STRING
/INTO THE OUTPUT BUFFER. ONE ARGUMENT
/BIT0 IS SET IF CHARS ARE PACKED
/BIT1 IS SET IF THEY ARE PACKED
/     IN TSS/8 INTERNAL CODE
/BITS 6-11 CONTAIN CHARACTER COUNT
/ENTER WITH PTR. TO STRING IN ACC.
P=4000
T=2000

OUTCHR,	0
	DCA	CHRPTR
	TAD I	OUTCHR
	AND	(77)
	CIA
	DCA	OUTCNT
/ARE THE CHARS PACKED?
	TAD I	OUTCHR
	SPA CLA
	JMP	UNPACK		/YES

/COMES HERE IF CHARS ARE ALREADY IN
/8-BIT ASCII.
	TAD I	CHRPTR
	DCA I	POINT
	ISZ	CHRPTR
	ISZ	POINT
	ISZ	OUTCNT
	JMP	.-5
OTCEXT,	CLA
	ISZ	OUTCHR
	JMP I	OUTCHR
CHRPTR,	0
OUTCNT,	0

/COMES HERE IF CHARS ARE PACKED
/ARE THEY IN INTERNAL CODE?

UNPACK,	TAD I	OUTCHR
	RTL;	CLA
	SZL
	TAD	(40)
	DCA	CONVRT
/NOW START GETTING CHARS
NPCK1,	TAD I	CHRPTR
	RTR;	RTR;	RTR
	JMS	EXPAND
	ISZ	OUTCNT
	SKP
	JMP	OTCEXT
	TAD I	CHRPTR
	JMS	EXPAND
	ISZ	CHRPTR
	ISZ	OUTCNT
	JMP	NPCK1
	JMP	OTCEXT
CONVRT,	0

/EXPAND THE 6-BIT AC CHAR TO 8-BITS,
/THEN PUT IT IN OUTPUT BUFFER

EXPAND,	0
	TAD	CONVRT
	AND	(77)
	DCA	SIXBIT
	TAD	SIXBIT
	AND	(40)
	SNA CLA
	TAD	(100)
	TAD	(200)
	TAD	SIXBIT
	DCA I	POINT
	ISZ	POINT
	JMP I	EXPAND
SIXBIT,	0

/ROUTINE TO PUT SOME BLANKS IN THE
/OUTPUT BUFFER

BLANK0,	0
	TAD I	BLANK0
	CIA
	DCA	BLNKCT
	TAD	(SPACE)
	PUTCHR
	0001			/ONE 8-BIT SPACE
	ISZ	BLNKCT
	JMP	.-4
	JMP I	BLANK0
BLNKCT,	0
SPACE,	240
STATBL,	TEXT "^BS FIP RUN TIMRFIL0FIL1FIL2FIL3"
	*.-1
	TEXT "KEY LPT TTY PTR PTP ???0???1SI  "
	*.-1
	TEXT "DTA DTATRK05CDR ???5???6???7TOFF"
$$$$$$$$
